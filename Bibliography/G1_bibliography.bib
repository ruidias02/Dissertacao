	keywords = {Autonomous vehicle, Digital twin-based vehicular networks, Hierarchical federated transfer learning, Vehicular ad-hoc network, Vehicular digital twin},
	pages = {100303},
	file = {ScienceDirect Snapshot:C\:\\Users\\Asus\\Zotero\\storage\\G3JYDSND\\S2667295225000078.html:text/html},
