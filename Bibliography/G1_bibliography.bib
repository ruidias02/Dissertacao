@article{al-qutwani_smart_2019,
	title = {Smart {Traffic} {Lights} over {Vehicular} {Named} {Data} {Networking}},
	volume = {10},
	copyright = {http://creativecommons.org/licenses/by/3.0/},
	issn = {2078-2489},
	url = {https://www.mdpi.com/2078-2489/10/3/83},
	doi = {10.3390/info10030083},
	abstract = {The existing traffic light system fails to deal with the increase in vehicular traffic requirements due to fixed time programming. Traffic flow suffers from vehicle delay and congestion. A new networking technology called vehicular ad hoc networking (VANET) offers a novel solution for vehicular traffic management. Nowadays, vehicles communicate with each other (V2V), infrastructure (V2I), or roadside units (V2R) using IP-based networks. Nevertheless, IP-based networks demonstrate low performance with moving nodes as they depend on communication with static nodes. Currently, the research community is studying a new networking architecture based on content name called named data networking (NDN) to implement it in VANET. NDN is suitable for VANET as it sends/receives information based on content name, not content address. In this paper, we present one of VANET’s network applications over NDN, a smart traffic light system. Our system solves the traffic congestion issue as well as reducing the waiting time of vehicles in road intersections. This system replaces the current conventional system with virtual traffic lights (VTLs). Instead of installing traffic lights at every intersection, we utilize a road side unit (RSU) to act as the intersection controller. Instead of a light signal, the RSU collects the orders of vehicles that have arrived or will arrive at the intersection. After processing the orders according to the priority policy, the RSU sends an instant message for every vehicle to pass the intersection or wait for a while. The proposed system mimics a human policeman intersection controlling. This approach is suitable for autonomous vehicles as they only receive signals from the RSU instead of processing many images. We provide a map of future work directions for enhancing this solution to take into account pedestrian and parking issues.},
	language = {en},
	number = {3},
	urldate = {2025-06-30},
	journal = {Information},
	author = {Al-qutwani, Majed and Wang, Xingwei},
	month = mar,
	year = {2019},
	note = {Number: 3
Publisher: Multidisciplinary Digital Publishing Institute},
	keywords = {VANET, vehicular ad hoc networking, vehicular named data networking, virtual traffic lights},
	pages = {83},
	file = {Full Text PDF:C\:\\Users\\Asus\\Zotero\\storage\\KE7L2ELI\\Al-qutwani e Wang - 2019 - Smart Traffic Lights over Vehicular Named Data Net.pdf:application/pdf},
}

@article{lu_connected_2014,
	title = {Connected {Vehicles}: {Solutions} and {Challenges}},
